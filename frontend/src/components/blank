    center: {
        flex: 1,
        justifyContent: 'center',
        alignItems: 'center',
    },
    previewImage: {
        width: '90%',
        height: '90%',
        borderRadius: 10
    },
    buttonCtn: {
        position: 'absolute',
        bottom: 50,
        alignSelf: 'center'

    }
