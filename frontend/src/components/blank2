import { StyleSheet, Text, View, Button } from 'react-native'

import React, { useEffect, useState } from 'react'

import { Camera, useCameraPermission, usePhotoOutput, useCameraDevice } from 'react-native-vision-camera'

import { NitroImage } from 'react-native-nitro-image'

import { useResizer } from 'react-native-vision-camera-resizer'

import { useTensorflowModel } from 'react-native-fast-tflite'





const CameraComponent = () => {

    const [takingPhoto, setTakingPhoto] = useState(false)

    const { hasPermission, requestPermission } = useCameraPermission()

    const device = useCameraDevice('back')

    const photoOutput = usePhotoOutput()

    const [capturedImage, setCapturedImage] = useState(null)

    const [pixels, setPixels] = useState(null)
    const plugin = useTensorflowModel(require('../../assets/best.tflite'))
    const model = plugin.model
    const { resizer } = useResizer({
        height: 224,
        width: 224,
        dataType: "uint8",
        channelOrder: 'rgb',
        scaleMode: "cover",
        pixelLayout: "planar"
    })
    useEffect(() => {
        if (!hasPermission) {
            requestPermission()
        }
    }, [hasPermission, requestPermission])

    const takePicture = async () => {
        if (photoOutput) {
            try {
                const photo = await photoOutput.capturePhoto({
                    flashMode: 'off'
                }, {})
                const image = await photo.toImageAsync()
                console.log("Extracted image:", image)
                const resizedBuffer = resizer.resize(image)
                setCapturedImage(image)
                await photo.dispose()
                setTakingPhoto(false)
            } catch (error) {
                console.error(error)
                setTakingPhoto(false)
            }
        }
    }
    if (!hasPermission) {
        return (
            <View style={styles.center}>
                <Text>No Camera Permission</Text>
            </View>
        )
    }

    return (

        <View style={{ flex: 1 }}>
            {!takingPhoto && !capturedImage && (
                <View style={styles.center}>
                    <Button title="Take Picture" onPress={() => setTakingPhoto(true)} />
                </View>
            )}
            {takingPhoto && device && (
                <View style={StyleSheet.absoluteFillObject}>
                    <Camera
                        isActive={true}
                        device={device}
                        style={StyleSheet.absoluteFill}
                        outputs={[photoOutput]}
                    />
                    <View style={styles.buttonCtn}>
                        <Button
                            title="Click Picture"
                            onPress={() => {
                                takePicture()
                            }}
                        />
                    </View>
                </View>

            )}

            {capturedImage && !takingPhoto && (
                <View style={{ flex: 1, justifyContent: 'center', alignItems: 'center' }}>
                    <Text>Picture Taken!</Text>
                    <NitroImage
                        style={styles.previewImage}
                        image={capturedImage}
                    />
                    <Button title="Take Another Picture" onPress={() => {
                        setCapturedImage(null)
                        setTakingPhoto(true)
                    }}/>
                </View>

            )}





        </View>





    )

}



export default CameraComponent



const styles = StyleSheet.create({

    center: {

        flex: 1,

        justifyContent: 'center',

        alignItems: 'center',

    },

    previewImage: {

        width: '90%',

        height: '90%',

        borderRadius: 10

    },

    buttonCtn: {

        position: 'absolute',

        bottom: 20,

        alignSelf: 'center'



    }

})



